# ─────────────────────────────────────────────────────────────────────────────
# OpenCode Telegram Gateway — secrets & settings
#
# Copy to ~/.config/opencode/telegram-gateway.env and edit.
#   cp .env.example ~/.config/opencode/telegram-gateway.env
#   chmod 600 ~/.config/opencode/telegram-gateway.env
#
# The loader REQUIRES mode 0600 and current-user ownership, and accepts only
# TELEGRAM_* / OPENCODE_TELEGRAM_* keys. Real environment variables win over
# this file. Never commit a filled-in copy. After editing, run /reload in
# OpenCode (the secrets file itself is not watched).
#
# SECURITY: never paste the bot token into chat or a tool call. Use
# scripts/write-secrets.sh in your own terminal to enter it with `read -s`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────
# BotFather token, shape <numeric-id>:<secret>. The plugin fails closed without it.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user IDs allowed to talk to the bot (CSV).
# Empty = default-deny: every sender gets the approval notice / silence.
TELEGRAM_ALLOWED_USERS=

# ── Admin / command ACL ─────────────────────────────────────────────────────
# Admin IDs for control commands (CSV). Empty = gating OFF (all authorized
# users may run all commands). Set this on shared groups to enable gating.
OPENCODE_TELEGRAM_ADMIN_USERS=

# Commands non-admins may run when gating is ON (CSV). Always allowed:
# help, whoami. Defaults: help,whoami,status,model,models
OPENCODE_TELEGRAM_USER_COMMANDS=help,whoami,status,model,models

# What an unknown sender gets: "pair" (approval instructions) or "ignore" (silence).
OPENCODE_TELEGRAM_UNAUTHORIZED_BEHAVIOR=pair

# ── Transport: polling (default) vs webhook ─────────────────────────────────
# Set WEBHOOK_URL + WEBHOOK_SECRET to use webhook mode instead of polling.
# Leave both blank for long polling. Secret must be >= 32 chars: openssl rand -hex 32
# Startup REFUSES a webhook URL without a secret (GHSA-3vpc-7q5r-276h).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Bind host/port for the built-in webhook listener (plain HTTP — terminate TLS
# at a reverse proxy). Keep host loopback unless you know what you are doing.
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8443

# ── Group trigger gates (WHEN to answer; separate from authorization) ────────
# Chats where the bot responds (CSV chat ids). Empty = all groups.
TELEGRAM_ALLOWED_CHATS=
# Forum topic ids where the bot responds (CSV). Empty = all topics.
TELEGRAM_ALLOWED_TOPICS=
# Thread/topic ids to always skip (CSV).
TELEGRAM_IGNORED_THREADS=
# In groups, require @botname or a reply to the bot to trigger: true|false.
TELEGRAM_REQUIRE_MENTION=false
# Outside allowed chats, respond only to explicit @mention: true|false.
TELEGRAM_GUEST_MODE=false
# Chats/topics exempt from require_mention (CSV).
TELEGRAM_FREE_RESPONSE_CHATS=
# Multi-bot groups: a leading @otherbot silences this bot: true|false.
TELEGRAM_EXCLUSIVE_BOT_MENTIONS=true

# ── Agent / session behavior ────────────────────────────────────────────────
# Agent name for Telegram sessions (blank = default agent).
OPENCODE_TELEGRAM_AGENT=
# Working directory for Telegram sessions (blank = current location).
OPENCODE_TELEGRAM_WORKDIR=
# Group sessions: isolate per sender (true, default) or share per chat (false).
OPENCODE_TELEGRAM_GROUP_SESSIONS_PER_USER=true
# Forum topics: isolate per sender (true) or share per topic (false, default).
OPENCODE_TELEGRAM_THREAD_SESSIONS_PER_USER=false
# DM threads: per_thread (default) or shared (collapse into one session).
OPENCODE_TELEGRAM_DM_THREADS=per_thread
# Actions set to "ask" for Telegram sessions (CSV). Approvals appear in the
# OpenCode TUI/desktop. Empty = no extra restrictions.
OPENCODE_TELEGRAM_DENIED_TOOLS=bash,edit,write,patch
# Streaming previews via message edits: true|false.
OPENCODE_TELEGRAM_STREAM=true
# Preview edit throttle in ms (100..10000).
OPENCODE_TELEGRAM_EDIT_INTERVAL_MS=800

# ── Message rendering ───────────────────────────────────────────────────────
# Render replies as MarkdownV2 with a plain fallback on parse errors: true|false.
OPENCODE_TELEGRAM_MARKDOWN=true
# Native Rich Messages (Bot API 10.1): raw GFM markdown rendered by Telegram.
# Uses sendRichMessage for headings/tables/task lists/code/math; falls back to
# MarkdownV2 on parse errors and latches off if the method is unavailable.
# Streaming previews are disabled while this is on (the rich final is one message).
OPENCODE_TELEGRAM_RICH_MESSAGES=true
# Max outbound UTF-16 chars per message (100..4096).
OPENCODE_TELEGRAM_MAX_CHARS=4000
# Max entries in the "/" command menu (1..100; hidden commands still dispatch).
OPENCODE_TELEGRAM_COMMAND_MENU_MAX=60
# Polish: 👀 while working + 👍/👎 on completion (reactions): true|false.
TELEGRAM_REACTIONS=false
# Typing indicator (sendChatAction) while the agent works: true|false.
OPENCODE_TELEGRAM_TYPING=true
# Flip the bot's short description to Online/Offline: true|false.
OPENCODE_TELEGRAM_STATUS_INDICATOR=false
# Surface OpenCode permission requests as Telegram approval cards: true|false.
OPENCODE_TELEGRAM_APPROVALS=true
# Seconds before a pending approval is auto-denied (fail closed). 5..3600.
OPENCODE_TELEGRAM_APPROVAL_TIMEOUT=300

# ── Inbound batching ────────────────────────────────────────────────────────
# Merge client-split text / photo bursts into one turn. 0 disables.
OPENCODE_TELEGRAM_TEXT_BATCH_MS=1200
OPENCODE_TELEGRAM_MEDIA_BATCH_MS=800

# ── Media pipeline ──────────────────────────────────────────────────────────
# Enable inbound/outbound media: true|false.
OPENCODE_TELEGRAM_MEDIA=true
# Hard per-file download/upload cap in bytes (1024..104857600). Default 20 MiB.
OPENCODE_TELEGRAM_MAX_MEDIA_BYTES=20971520
# Inbound media cache root (blank = system temp/opencode-telegram-media).
OPENCODE_TELEGRAM_CACHE_DIR=

# ── Flood control (persisted per-chat 429 windows) ──────────────────────────
# Flood-window file (blank = data dir/telegram-flood-<botid>.json, mode 0600).
OPENCODE_TELEGRAM_FLOOD_FILE=

# ── Voice transcription (optional; OpenAI-compatible /audio/transcriptions) ─
# Leave URL blank to disable STT. Voice notes are otherwise cached with a path note.
OPENCODE_TELEGRAM_STT_URL=
OPENCODE_TELEGRAM_STT_KEY=
OPENCODE_TELEGRAM_STT_MODEL=whisper-1

# ── Image/sticker vision (optional; OpenAI-compatible /chat/completions) ────
# Leave URL blank to disable vision.
OPENCODE_TELEGRAM_VISION_URL=
OPENCODE_TELEGRAM_VISION_KEY=
OPENCODE_TELEGRAM_VISION_MODEL=gpt-4o-mini
OPENCODE_TELEGRAM_VISION_PROMPT=Describe this image or sticker in one short sentence.
# Also describe ordinary images (else attached directly to the model): true|false.
OPENCODE_TELEGRAM_VISION_IMAGES=false
# Sticker vision cache file (blank = data dir/telegram-sticker-vision.json).
OPENCODE_TELEGRAM_VISION_CACHE=

# ── Misc ────────────────────────────────────────────────────────────────────
# Path to this env file (blank = ~/.config/opencode/telegram-gateway.env).
TELEGRAM_GATEWAY_ENV_FILE=
# Reserved strict-mode flag (future use).
OPENCODE_TELEGRAM_STRICT=true
